# Copy to infra/.env (docker compose reads it) — all values have working defaults.
POSTGRES_USER=atm
POSTGRES_PASSWORD=atm
POSTGRES_DB=atm
DATABASE_URL=postgresql://atm:atm@postgres:5432/atm
REDIS_URL=redis://redis:6379/0
ENGINE_URL=http://engine:8000
SESSION_SECRET=change-me-in-production-32-bytes-min
# Optional LLM for the mentor. Gemini is used when GEMINI_API_KEY is set (free tier at aistudio.google.com),
# else Claude when ANTHROPIC_API_KEY is set, else deterministic template responses.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# synthetic | csv
DATA_PROVIDER=synthetic
# Paper-trader replay speed in 1-minute bars per real second
PAPER_SPEED=2
