{
  "version": 1,
  "description": "A strategy is testable when every rule passes. Interpreted identically by src/testable.ts and engine/schema/testable.py. A path is 'present' when it resolves to a value that is not null, not an empty array, not an empty string, and not equal to `not`.",
  "rules": [
    { "id": "entry", "kind": "present_any", "paths": [{ "path": "/entry_long" }, { "path": "/entry_short" }], "missing": "At least one entry condition, long or short." },
    { "id": "stop", "kind": "present_any", "paths": [{ "path": "/stop/type" }], "missing": "A stop rule." },
    { "id": "exit", "kind": "present_any", "paths": [{ "path": "/targets" }, { "path": "/trailing/type", "not": "none" }, { "path": "/time_exit/max_bars" }, { "path": "/time_exit/at_time" }], "missing": "At least one exit: a target, a trailing rule, or a time exit." },
    { "id": "timeframe", "kind": "present_any", "paths": [{ "path": "/timeframe" }], "missing": "A timeframe." },
    { "id": "session_start", "kind": "present_any", "paths": [{ "path": "/session/start" }], "missing": "A session start time." },
    { "id": "session_end", "kind": "present_any", "paths": [{ "path": "/session/end" }], "missing": "A session end time." },
    { "id": "ambiguity", "kind": "empty", "paths": [{ "path": "/ambiguity_flags" }], "missing": "Resolve every ambiguity flag: {values}." }
  ]
}
